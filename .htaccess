# Habilitar reescrita de URL
RewriteEngine On
RewriteBase /

# Redirecionar /termos para termos.html (mantém a URL limpa)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^termos$ termos.html [L]

# Redirecionar /privacidade para privacidade.html (mantém a URL limpa)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^privacidade$ privacidade.html [L]